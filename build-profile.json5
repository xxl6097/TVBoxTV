{
  "app": {
    // 不要在这里填签名：hvigor 的 signingConfigs 只认 DevEco 加密后的口令密文
    // （长度 ≥ 32），写明文的 p12 口令会被直接拒绝：
    //   「The length of the storePassword or keyPassword field is less than 32」
    // 所以本地命令行出包统一走 scripts/build-tv.sh：
    //   hvigor 出未签名 hap → hap-sign-tool 用 ~/.ohos/debug-key/ 里的调试证书补签。
    // 调试描述文件 hongmengyingshi-debug.p7b（包名 com.hong.tv）的
    // debug-info.device-ids 白名单里包含：
    //   BE38CEEEE9631D074204DBCF40DADC68146195564CDE799E1B1259617D29A893（手机）
    //   C449CED6912DB8E5AEB550EAF97A76BEEBEF5CF86D5C87FB250A21F1994F59C2（电视 EDIS-760E）
    // 有效期 2026-11-03 → 2027-11-03。换新设备要回 AGC 重新签发描述文件，
    // 否则装上去报 9568425 device is unauthorized。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // DevEco 生成签名时只写 signingConfigs，不写这条引用；
        // 缺了它会 warn「No signingConfig found for product default」并产出未签名包。
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        },
        "targetSdkVersion": ""
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
